server {
    listen 80;
    server_name localhost;

    root /var/www/html/erm;
    index index.php index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

    # Pass PHP scripts to PHP-FPM
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;  # Check your PHP version here
    }

    location ~ /\.ht {
        deny all;
    }
}
